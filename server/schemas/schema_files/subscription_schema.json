{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Subscription",
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "uuid": {
        "type": "string",
        "maxLength": 40
      },
      "tier": {
        "type": "string",
        "enum": ["free", "enterprise", "pro"]  
      },
      "expiration": {
        "type": ["string", "null"],
        "maxLength": 40
      }
    },
    "required": [
      "uuid",
      "tier"
    ],
    "additionalProperties": false
  }
  