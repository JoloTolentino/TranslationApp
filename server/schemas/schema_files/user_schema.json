{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "type": "object",
    "properties": {
      "uuid": {
        "type": "string",
        "maxLength": 50
      },
      "firstname": {
        "type": "string",
        "maxLength": 20
      },
      "lastname": {
        "type": "string",
        "maxLength": 20
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 120
      },
      "username": {
        "type": "string",
        "maxLength": 20
      },
      "password": {
        "type": "string",
        "maxLength": 250
      },
      "is_online": {
        "type": "boolean",
        "default": false
      },
      "last_login": {
        "type": ["string", "null"],
        "maxLength": 20
      }
    },
    "required": [
      "uuid",
      "firstname",
      "lastname",
      "email",
      "username",
      "password",
      "is_online"
    ],
    "additionalProperties": false
  }
  