{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "type": "object",
    "properties": {
      
      "firstname": {
        "type": "string",
        "maxLength": 20
      },
      "lastname": {
        "type": "string",
        "maxLength": 20
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 120
      },
      "username": {
        "type": "string",
        "maxLength": 20
      },
      "password": {
        "type": "string",
        "maxLength": 250
      }
    },
    "required": [
      "firstname",
      "lastname",
      "email",
      "username",
      "password"
    ],
    "additionalProperties": false
  }
  